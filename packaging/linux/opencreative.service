# systemd *user* service running the OpenCreative daemon, which owns the cooler
# screen. While it runs, `opencreative` commands are sent to it.
# Install:
#   cp opencreative.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now opencreative

[Unit]
Description=OpenCreative cooler screen

[Service]
ExecStart=%h/.cargo/bin/opencreative daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
